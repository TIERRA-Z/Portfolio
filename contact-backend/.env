# Copy this file to .env and fill in real values. Never commit the real .env file.

# The email address YOU want to receive contact form messages at
TO_EMAIL=doughtytierra@gmail.com

# Gmail SMTP setup (works well for a personal site):
# 1. Turn on 2-Step Verification on the Gmail account you'll send from
# 2. Create an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use that app password below (NOT your normal Gmail password)

SMTP_EMAIL=doughtytierra@gmail.com
SMTP_APP_PASSWORD=uufxmkhsektspjup

# Comma-separated list of frontend origins allowed to call this API
# e.g. https://yourportfolio.com,http://localhost:5500
ALLOWED_ORIGINS=http://127.0.0.1:5500

# Port the server runs on
PORT=3001
 